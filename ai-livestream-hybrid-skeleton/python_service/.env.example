# Server
HOST=127.0.0.1
PORT=8088
LOG_LEVEL=INFO

# TTS mode: mock | azure | elevenlabs
TTS_PROVIDER=mock
OUTPUT_AUDIO_PATH=output.wav

# Azure TTS placeholders
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_VOICE_NAME=vi-VN-HoaiMyNeural

# ElevenLabs placeholders
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Avatar mode: mock | vtube_studio
AVATAR_PROVIDER=mock
VTUBE_STUDIO_WS=ws://127.0.0.1:8001

# OBS / audio routing note:
# Set OBS to capture the same output device used by your TTS playback layer.

TTS_PROVIDER=azure

AZURE_SPEECH_KEY=YOUR_KEY
AZURE_SPEECH_REGION=southeastasia
AZURE_VOICE_NAME=vi-VN-HoaiMyNeura

