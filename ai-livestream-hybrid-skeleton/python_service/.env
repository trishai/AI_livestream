# Server
HOST=127.0.0.1
PORT=8088
LOG_LEVEL=INFO

# TTS
#TTS_PROVIDER=azure
TTS_PROVIDER=windows
OUTPUT_AUDIO_PATH=output.mp3

# Azure Speech
AZURE_SPEECH_KEY=YOUR_REAL_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=southeastasia
AZURE_VOICE_NAME=vi-VN-HoaiMyNeural

# Proxy for corporate network / px.exe
PROXY_HOST=127.0.0.1
PROXY_PORT=3128

# Optional: auto play generated wav on local speaker
#PLAY_AUDIO_AFTER_TTS=true

# Avatar
AVATAR_PROVIDER=mock
VTUBE_STUDIO_WS=ws://127.0.0.1:8001


TTS_PROVIDER=windows
PLAY_AUDIO_AFTER_TTS=true
WINDOWS_TTS_RATE=0
WINDOWS_TTS_VOLUME=100
